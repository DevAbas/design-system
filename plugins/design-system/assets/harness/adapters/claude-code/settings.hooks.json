{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/design-system/harness/with-node.sh .claude/hooks/design-system/protect-generated.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/design-system/harness/with-node.sh .claude/hooks/design-system/guard-commit.mjs",
            "timeout": 300,
            "statusMessage": "Design-system gates before the commit…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/design-system/harness/with-node.sh .claude/hooks/design-system/check-on-edit.mjs",
            "timeout": 120,
            "statusMessage": "Design-system checks on the edited file…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/design-system/harness/with-node.sh .claude/hooks/design-system/check-after-bash.mjs",
            "timeout": 120,
            "statusMessage": "Design-system checks on the files the command changed…"
          }
        ]
      }
    ]
  }
}
